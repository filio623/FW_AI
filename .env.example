SUPERMEMORY_API_KEY=sm_your_api_key_here
SUPERMEMORY_CONTAINER_TAG=ai-video-workflows
SUPERMEMORY_PROJECT=ai-video-workflows
COMFY_API_KEY=comfyui_your_key_here

# Optional RunPod overrides. `flash login` stores the API key in
# ~/.runpod/config.toml, so RUNPOD_API_KEY usually does not need to be copied here.
RUNPOD_API_KEY=runpod_your_key_here
RUNPOD_POD_ID=your_pod_id_here
RUNPOD_COMFYUI_PORT=8188
