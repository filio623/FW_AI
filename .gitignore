# Secrets and local environment
.env
.env.*
!.env.example

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Local caches and virtual environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.venv-*/
.uv-cache/
venv/
node_modules/

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.blend[0-9]
# Mantaflow writes its 24 MB noise tile to the working directory on upres bakes/renders
waveletNoiseTile.bin

# Generated review/output artifacts. Only the folder READMEs are tracked, so every
# outputs/ folder keeps its context even though its media is ephemeral.
outputs/**
!outputs/**/
!outputs/README.md
!outputs/**/README.md
memories/responses/
ComfyUI_temp_*.png

# Local plate/test media. Durable metadata belongs in docs/assets notes.
FW_test/

# Inbox is a staging area; keep only its README tracked.
assets/inbox/*
!assets/inbox/README.md

# Large production media should live in the workspace, not source control.
*.mov
*.mp4
*.m4v
*.avi
*.mkv
*.webm
*.exr
*.dpx
*.tif
*.tiff
*.psd
*.psb
*.aep
*.prproj
*.wav
*.aif
*.aiff
*.mp3
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# Stills cut from the plate are plate media; the mp4 inputs beside them are already ignored.
assets/elements/by-shot/**/*_start-frame_*.png

# Mickmumpitz library (references/mickmumpitz/): track the workflows, guides, index and
# helper scripts; keep example packs, media and extracted example folders local only.
references/mickmumpitz/**
!references/mickmumpitz/**/
!references/mickmumpitz/**/*.json
!references/mickmumpitz/**/*.md
!references/mickmumpitz/**/*.txt
!references/mickmumpitz/**/*.tsv
!references/mickmumpitz/**/*.py
!references/mickmumpitz/**/*.js
!references/mickmumpitz/**/*.bat
!references/mickmumpitz/**/*.html
references/mickmumpitz/**/*EXAMPLE-FILES*/
references/mickmumpitz/**/*EXAMPLE_FILES*/
