# Secrets and local environment
.env
.env.*
!.env.example

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Local caches and virtual environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.venv-*/
.uv-cache/
venv/
node_modules/

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.blend[0-9]
# Mantaflow writes its 24 MB noise tile to the working directory on upres bakes/renders
waveletNoiseTile.bin

# Generated review/output artifacts (project-wide outputs/, each shot's outputs/ and each
# character's outputs/). Only the folder READMEs are tracked, so every folder keeps its
# context even though its media is ephemeral.
outputs/**
!outputs/**/
!outputs/README.md
!outputs/**/README.md
shots/*/outputs/**
!shots/*/outputs/**/
!shots/*/outputs/**/README.md
characters/*/outputs/**
!characters/*/outputs/**/
!characters/*/outputs/**/README.md
ComfyUI_temp_*.png

# Local plate/test media. Durable metadata belongs in docs/assets notes.
FW_test/

# Inbox is a staging area; keep only its README tracked.
inbox/*
!inbox/README.md

# Large production media should live in the workspace, not source control.
*.mov
*.mp4
*.m4v
*.avi
*.mkv
*.webm
*.exr
*.dpx
*.tif
*.tiff
*.psd
*.psb
*.aep
*.prproj
*.wav
*.aif
*.aiff
*.mp3
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# Stills cut from the plate are plate media; the mp4 inputs beside them are already ignored.
shots/*/**/*_start-frame_*.png

# Mickmumpitz library (library/mickmumpitz/): track the workflows, guides, index and
# helper scripts; keep example packs, media and extracted example folders local only.
library/mickmumpitz/**
!library/mickmumpitz/**/
!library/mickmumpitz/**/*.json
!library/mickmumpitz/**/*.md
!library/mickmumpitz/**/*.txt
!library/mickmumpitz/**/*.tsv
!library/mickmumpitz/**/*.py
!library/mickmumpitz/**/*.js
!library/mickmumpitz/**/*.bat
!library/mickmumpitz/**/*.html
library/mickmumpitz/**/*EXAMPLE-FILES*/
library/mickmumpitz/**/*EXAMPLE_FILES*/

# Higgsfield keyframes are plate-derived stills, ignored like the plate; the README and
# registration JSON are tracked.
shots/*/**/keyframes/**/*.png

# Generated comp layers (frame sequences): media local, README and reports tracked.
shots/*/**/layers/**/*.jpg
shots/*/**/layers/**/*.png
shots/*/**/layers/**/*.exr
