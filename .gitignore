# Secrets and local environment
.env
.env.*
!.env.example

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Local caches and virtual environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.venv-*/
.uv-cache/
venv/
node_modules/

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.blend[0-9]
# Mantaflow writes its 24 MB noise tile to the working directory on upres bakes/renders
waveletNoiseTile.bin

# Generated review/output artifacts
outputs/
memories/responses/
ComfyUI_temp_*.png

# Local plate/test media. Durable metadata belongs in docs/assets notes.
FW_test/

# Inbox is a staging area; keep only its README tracked.
assets/inbox/*
!assets/inbox/README.md

# Large production media should live in the workspace, not source control.
*.mov
*.mp4
*.m4v
*.avi
*.mkv
